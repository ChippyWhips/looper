{
	"name": "looper",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest run && playwright test",
		"test:e2e": "playwright test",
		"fixtures": "tsx scripts/make-fixtures.ts",
		"verify": "npm run fixtures && npm run check && npm run lint && vitest run && playwright test",
		"tauri": "tauri",
		"desktop:dev": "tauri dev",
		"desktop:build": "tauri build",
		"desktop:install": "tauri build && (osascript -e 'quit app \"Looper\"' || true) && rm -rf ~/Applications/Looper.app && ditto src-tauri/target/release/bundle/macos/Looper.app ~/Applications/Looper.app",
		"test:native": "cd src-tauri && cargo test"
	},
	"devDependencies": {
		"@breezystack/lamejs": "^1.2.7",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tauri-apps/cli": "^2.12.4",
		"@types/node": "^24",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource/geist-mono": "^5.3.0",
		"@tauri-apps/api": "^2.12.4",
		"essentia.js": "^0.1.3",
		"signalsmith-stretch": "^1.3.2"
	}
}
