{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Looper",
	"version": "0.1.0",
	"identifier": "app.looper.desktop",
	"build": {
		"frontendDist": "../build",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "npm run dev",
		"beforeBuildCommand": "npm run build"
	},
	"app": {
		"windows": [
			{
				"title": "Looper",
				"width": 1512,
				"height": 982,
				"minWidth": 1280,
				"minHeight": 800,
				"dragDropEnabled": false,
				"backgroundColor": "#0e0e0e",
				"titleBarStyle": "Overlay",
				"hiddenTitle": true,
				"trafficLightPosition": {
					"x": 16,
					"y": 22
				}
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["app"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.png"
		]
	}
}
